PORT=3000
NODE_ENV=production
DATABASE_PATH=./data/civicresolve.db
STORAGE_DIR=./data/uploads

# REQUIRED in production: at least 32 random characters (openssl rand -hex 32)
JWT_SECRET=895a2dcdc56ddeb96c1d32e71391d0bdea8b7bd929d86dd0f97956567ac25909

# Staff accounts created by `npm run seed` when DEMO_MODE is not true
ADMIN_EMAIL=admin@civicresolve.internal
ADMIN_PASSWORD=admin@123$456789
OFFICER_PASSWORD=          # optional: also creates one officer per department

# DEMO ONLY. When true, the seed script creates demo accounts and sample cases, and the staff
# sign-in page shows one-click demo credentials to everyone. Never enable on a real deployment.
DEMO_MODE=false

# Set true once the site is served over HTTPS; set TRUST_PROXY=1 behind a reverse proxy
COOKIE_SECURE=false
TRUST_PROXY=
